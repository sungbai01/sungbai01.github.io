{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "galpi-bookshelf-auth",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-21",
	"workers_dev": true,
	"preview_urls": false,
	"triggers": {"crons":["*/15 * * * *"]},
	"r2_buckets": [{"binding":"SHARE_IMAGES","bucket_name":"galpi-bookshelf-share-images"}],
	"ratelimits": [
 {"name":"VISITOR_LIMIT","namespace_id":"7864382291","simple":{"limit":240,"period":60}},
 {"name":"AUTH_LIMIT","namespace_id":"7864382292","simple":{"limit":12,"period":60}},
 {"name":"SHARE_LIMIT","namespace_id":"7864382293","simple":{"limit":600,"period":60}},
 {"name":"ACCOUNT_LIMIT","namespace_id":"7864382294","simple":{"limit":120,"period":60}}
 ],
 "observability": {
		"enabled": false
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://sungbai01.github.io"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "galpi-bookshelf-text",
			"database_id": "a87ba9f9-fce9-4024-b71b-1ef38038cad7"
		}
	]
}
